# Copy to .env and fill in for local dev:
#   cp .env.example .env

# Postgres connection string.
# Local (Docker Compose): postgres://qpinoy:qpinoy@localhost:5433/qpinoy
# Local (native):          postgres://localhost:5432/qpinoy
# Neon / Supabase / Render (production): use the connection string they
# give you. db.js automatically enables SSL for any non-localhost host,
# so you don't need to add ?sslmode=require yourself.
DATABASE_URL=postgres://qpinoy:qpinoy@localhost:5433/qpinoy

# REQUIRED. Signs login sessions and the QR check-in tokens. At least
# 32 characters. There is deliberately NO built-in default: a shared
# default secret forges every session in the system, so the server
# refuses to start without this rather than booting insecure.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Use a DIFFERENT value in production than in local dev, and treat it
# like a password — changing it signs everyone out, which is also how
# you revoke all sessions if it ever leaks.
AUTH_SECRET=

# Port the API listens on (server.js / local dev only — ignored by the
# Netlify Functions deployment, which is invoked per-request).
PORT=4000

# Only needed if the frontend is served from a DIFFERENT origin than
# this API. Comma-separated allowlist, no spaces needed (trimmed).
# Example: CORS_ORIGINS=https://app.qpinoy.com,https://admin.qpinoy.com
CORS_ORIGINS=

# Set to 1 when running behind a reverse proxy / platform load balancer
# (Render, Fly, Railway, Netlify Functions) so req.ip and req.protocol
# reflect the real client.
TRUST_PROXY=1

# Optional. Without this, ETA falls back to a straight-line distance
# estimate (fine for local dev/tests). Restrict this key to your
# server's IP in Google Cloud Console before using it in production.
GOOGLE_MAPS_API_KEY=

# Optional. Without these, push notifications are silently disabled —
# the frontend's "enable notifications" card doesn't appear at all (same
# fallback shape as GOOGLE_MAPS_API_KEY above) and the queue engine's
# notify calls become no-ops. Generate a pair once per environment (NOT
# per deploy — rotating it invalidates every existing subscription) with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT should be a mailto: or https: URL the push service can
# use to contact you if your key is misbehaving.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# The master switch for the whole subscription/billing feature.
# Defaults to OFF (anything other than the literal string "true"):
# while off, no venue is ever blocked from taking customers regardless
# of trial/payment state, the Billing screen and its console button
# stay hidden, and POST .../billing/checkout refuses even if a
# provider's credentials below happen to be configured — this flag
# overrides everything else in this section. Flip it on once you're
# actually ready to sell subscriptions.
SUBSCRIPTION_ENABLE=false

# REQUIRED for any subscription checkout to work (backend/billingRoutes.js
# builds the success/cancel redirect URLs from this). The frontend's own
# origin, no trailing slash — e.g. https://app.qpinoy.com, or
# http://192.168.1.50:5173 for phone-on-LAN local testing.
APP_ORIGIN=

# Optional. Without a secret key, GCash/PayMaya/card checkout is
# silently unavailable — Billing.jsx just doesn't offer it, same
# fallback shape as GOOGLE_MAPS_API_KEY. Get sandbox keys instantly
# (no business verification needed for test mode) from the PayMongo
# Dashboard → Developers → API Keys.
#
# PAYMONGO_WEBHOOK_SECRET is DIFFERENT from the secret key above — it's
# shown once when you create the webhook endpoint (Dashboard →
# Developers → Webhooks), pointed at:
#   POST <APP_ORIGIN-but-on-the-API-host>/api/webhooks/paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Optional. Without client id/secret, PayPal checkout is silently
# unavailable, same fallback shape. Create a sandbox app instantly at
# developer.paypal.com/dashboard/applications — no business verification
# needed for sandbox. PAYPAL_MODE defaults to sandbox if unset; set it
# to "live" only once you're ready for real charges.
#
# PAYPAL_WEBHOOK_ID comes from creating a webhook (Dashboard → your
# app → Add Webhook) pointed at POST .../api/webhooks/paypal, subscribed
# to at least the PAYMENT.CAPTURE.COMPLETED event.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Optional. The subscription plan's price, in PHP CENTAVOS (so 39900 =
# ₱399.00) — same "smallest unit, no float rounding" convention
# PayMongo itself uses. Defaults to 39900 if unset. See subscriptions.js.
SUBSCRIPTION_PRICE_PHP_CENTAVOS=39900
